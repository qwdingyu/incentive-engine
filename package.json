{
  "name": "@usethink/incentive-engine",
  "version": "4.1.0",
  "description": "通用营销激励引擎 — 领域无关的纯计算核心，支持 DIRECT/LEVEL/FIXED/CUSTOM 奖励分配、封顶裁剪、预算兜底、等级评估、条件评估、流水线编排、配置校验、灰度版本路由",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./pure": {
      "types": "./src/pure.d.ts",
      "default": "./src/pure.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "smoke": "node scripts/smoke-require.js && node scripts/smoke-business.js && node scripts/smoke-pure.js",
    "prepublishOnly": "node scripts/verify-pack.js && node scripts/smoke-pure.js"
  },
  "keywords": [
    "marketing",
    "incentive",
    "engine",
    "commission",
    "reward",
    "distribution"
  ],
  "license": "MIT",
  "author": "usethink contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwdingyu/incentive-engine.git"
  },
  "homepage": "https://www.npmjs.com/package/@usethink/incentive-engine",
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "peerDependencies": {
    "joi": "^17.0.0",
    "sequelize": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "joi": {
      "optional": true
    },
    "sequelize": {
      "optional": true
    }
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "jest": "^29.7.0",
    "joi": "^17.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "statements": 92,
        "lines": 92,
        "functions": 95
      },
      "src/engine/**/*.js": {
        "branches": 85
      }
    }
  }
}
